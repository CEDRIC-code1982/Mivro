{
  "name": "@mivro/app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios-release": "react-native run-ios --configuration Release",
    "android-release": "cd android && ./gradlew assembleRelease",
    "start": "react-native start",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathIgnorePatterns \"/node_modules/\" \"/src/test-utils/\" \"\\\\.integration\\\\.test\\\\.tsx?$\"",
    "test:integration": "jest --testPathPattern \"\\\\.integration\\\\.test\\\\.tsx?$\"",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "check:arch": "depcruise src --config .dependency-cruiser.js",
    "check:arch:graph": "depcruise src --config .dependency-cruiser.js --output-type dot > .dependency-graph.dot",
    "check:diff": "bash scripts/check-diff.sh",
    "check:harness": "bash scripts/harness-selftest.sh",
    "docs:api": "typedoc",
    "docs": "typedoc && npm --prefix docs-site run build",
    "docs:dev": "typedoc && npm --prefix docs-site run start",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:arch && npm run check:diff && npm run test:ci",
    "prepare": "husky",
    "pods": "cd ios && rm -rf Pods/ && rm -rf build && rm -rf Podfile.lock && bundle install && bundle exec pod install && cd ..",
    "android-clean": "cd android && rm -rf app/.cxx && rm -rf app/build && ./gradlew --stop && ./gradlew clean && cd ..",
    "ios-clean": "cd ios && rm -rf build/ && rm -rf Pods/ && rm -rf Podfile.lock && cd ..",
    "clear": "rm -rf $TMPDIR/react-native-packager-cache-* &&  rm -rf $TMPDIR/metro-bundler-cache-* && rm -rf node_modules/ && npm cache clean --force &&  npm install && npm start -- --reset-cache"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.39.0",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/app": "^25.0.1",
    "@react-native-firebase/database": "^25.0.1",
    "@react-native/new-app-screen": "0.85.2",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@sentry/react-native": "^8.10.0",
    "@tanstack/react-query": "^5.100.9",
    "i18next": "^26.0.8",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.6",
    "react-native": "0.85.2",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-localize": "^3.7.0",
    "react-native-maps": "^1.26.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.8.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^8.19.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "jest-mock-extended": "^4.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  }
}
