{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git config *)",
      "Bash(git worktree *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(HUSKY=0 *)",
      "Bash(npm run harness:relock *)",
      "Bash(claude *)",
      "Bash(npx @anthropic-ai/claude-code *)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.config/gh"],
      "denyWrite": [
        "./scripts",
        "./.husky",
        "./.github",
        "./eslint-rules",
        "./eslint-local-rules.js",
        "./.eslintrc.js",
        "./.eslintignore",
        "./.prettierrc.js",
        "./.prettierignore",
        "./.dependency-cruiser.js",
        "./tsconfig.json",
        "./babel.config.js",
        "./.babelrc",
        "./.babelrc.js",
        "./.babelrc.cjs",
        "./.babelrc.mjs",
        "./.babelrc.json",
        "./babel.config.json",
        "./babel.config.cjs",
        "./babel.config.mjs",
        "./babel.config.cts",
        "./jest.config.js",
        "./jest.setup.js",
        "./typedoc.config.mjs",
        "./docs-site/docusaurus.config.ts",
        "./src/types/stdlib-unknown.d.ts",
        "./src/theme/contrast.test.ts",
        "./src/i18n/locales.parity.test.ts",
        "./src/i18n/locales.keys.test.ts",
        "./docs/harness/DONE-CONTRACT.modele.md",
        "./CLAUDE.md",
        "./CLAUDE.local.md",
        "./**/CLAUDE.md",
        "./**/CLAUDE.local.md"
      ]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "deniedDomains": ["github.com", "api.github.com", "*.github.com", "*.githubusercontent.com"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B -X pycache_prefix=/dev/null/mivro-nopyc \"$CLAUDE_PROJECT_DIR/scripts/hooks/pre-bash-guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B -X pycache_prefix=/dev/null/mivro-nopyc \"$CLAUDE_PROJECT_DIR/scripts/hooks/pre-edit-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/post-edit-check.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop-check.sh\"",
            "timeout": 180
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/reset-review.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "mivro-dev|mivro-tester",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop-check.sh\"",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/seal-review.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
