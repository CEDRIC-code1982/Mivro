{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],

    // [ADDED] TypeScript strict options per CLAUDE.md TS-001..TS-004
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // [MODIFIED] Override base config (was false)
    "forceConsistentCasingInFileNames": true,
    // [ADDED] Skip type checking of .d.ts in node_modules
    // Nécessaire car certaines libs (react-native-maps) ne supportent pas
    // exactOptionalPropertyTypes. Ne désactive PAS le check de notre code.
    "skipLibCheck": true,

    // [ADDED] Path aliases
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@features": ["src/features"],
      "@features/*": ["src/features/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@components": ["src/components"],
      "@components/*": ["src/components/*"],
      "@state": ["src/state"],
      "@state/*": ["src/state/*"],
      "@entities": ["src/entities"],
      "@entities/*": ["src/entities/*"],
      "@theme": ["src/theme"],
      "@theme/*": ["src/theme/*"],
      "@hooks": ["src/hooks"],
      "@hooks/*": ["src/hooks/*"],
      "@navigations": ["src/navigations"],
      "@navigations/*": ["src/navigations/*"],
      "@test-utils": ["src/test-utils"],
      "@test-utils/*": ["src/test-utils/*"],
      "react-native-maps": ["src/types/react-native-maps.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "**/build", "**/dist", "coverage"]
}
