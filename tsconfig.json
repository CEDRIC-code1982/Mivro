{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],

    // [ADDED] TypeScript strict options per CLAUDE.md TS-001..TS-004
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // [MODIFIED] Override base config (was false)
    "forceConsistentCasingInFileNames": true,
    // [ADDED] Skip type checking of .d.ts in node_modules
    // Nécessaire car certaines libs (react-native-maps) ne supportent pas
    // exactOptionalPropertyTypes. Ne désactive PAS le check de notre code.
    "skipLibCheck": true,

    // [ADDED] Path aliases
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@presentation/*": ["src/presentation/*"],
      "react-native-maps": ["src/types/react-native-maps.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
