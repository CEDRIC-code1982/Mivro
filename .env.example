# Sentry crash reporting
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Build identifiers (auto-injectés par CI plus tard)
SENTRY_RELEASE=

# Firebase Realtime Database (F4 — temps réel)
# URL publique (PAS un secret) — instance région europe-west1.
# Les instances RTDB hors us-central1 EXIGENT l'URL explicite côté SDK.
FIREBASE_DATABASE_URL=https://mivro-40125-default-rtdb.europe-west1.firebasedatabase.app/
