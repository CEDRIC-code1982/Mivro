# ---------------------------------------------------------------------------
# pre-push — the "push" stage of scripts/sensors.sh, on what is being pushed.
#
# Git passes one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# The diff range for check-diff is derived from those lines, not from @{u}:
# `git push origin other:develop` used to be checked against the wrong range
# (JOURNAL J-033). A new branch is compared with its merge-base on
# origin/develop (else origin/main).
#
# Same sensor table as `npm run check` and the CI, plus the documentation build.
# Local and bypassable by design (--no-verify): the CI is the real gate, and the
# Bash guard refuses --no-verify from the agent.
# ---------------------------------------------------------------------------

ZERO="0000000000000000000000000000000000000000"
ARGS=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue # ref deletion: nothing to check
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    base="$(git merge-base "$local_sha" origin/develop 2>/dev/null || git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    [ -n "$base" ] || base="$local_sha~1"
  else
    base="$remote_sha"
  fi
  ARGS="$ARGS --range $base...$local_sha"
done

[ -n "$ARGS" ] || exit 0

printf '▸ pre-push: sensors, stage push (%s)\n' "$(echo "$ARGS" | sed 's/--range //g')"
# shellcheck disable=SC2086  # ARGS is a list of --range options, split on purpose
exec bash scripts/check.sh --stage push $ARGS
